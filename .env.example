# ============================================================
# QForge Framework — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to: .env
#   2. Replace the placeholder values with your actual credentials
#   3. Never share or commit the .env file (it's in .gitignore)
# ============================================================

# ── Google Gemini API ────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDtxbNYIsJBJmlp1P-2lxy46Jdl4ZMfBQE

# ── MongoDB Connection ───────────────────────────────────────
# Local MongoDB : mongodb://localhost:27017
# MongoDB Atlas : mongodb+srv://manikanta:manikanta13@cluster0.31dau2a.mongodb.net/qforge_db?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://manikanta:manikanta13@cluster0.31dau2a.mongodb.net/qforge_db?retryWrites=true&w=majority
MONGODB_DB_NAME=qforge_db

# ── Ollama Local Inference Server ────────────────────────────
# Make sure Ollama is running: ollama serve
# Your available model: qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ROUTER_MODEL=qwen2.5-coder:3b
OLLAMA_GENERATOR_MODEL=qwen2.5-coder:3b
OLLAMA_VALIDATOR_MODEL=qwen2.5-coder:3b

# ── Gemini Model Selection ───────────────────────────────────
GEMINI_MODEL=gemini-1.5-flash

# ── Agent Orchestration Config ───────────────────────────────
# Complexity score >= this value → routes to Gemini cloud tier
MAX_REPAIR_CYCLES=3
COMPLEXITY_THRESHOLD=7

# ── FastAPI Server ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# ── FAISS Vector Store ───────────────────────────────────────
FAISS_INDEX_PATH=data/faiss_index/guidelines.index
FAISS_METADATA_PATH=data/faiss_index/chunk_metadata.json
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K_RETRIEVAL=5
